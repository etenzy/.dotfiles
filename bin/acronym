#!/usr/bin/env bash
set -euo pipefail

acronym_word() {
  local word="${1,,}"
  local consonants

  if (( ${#word} <= 4 )); then
    printf '%s' "$word"
    return
  fi

  case "$word" in
    application)    printf 'app' ;;
    archive)        printf 'arch' ;;
    audit)          printf 'audit' ;;
    banking)        printf 'bnkng' ;;
    billing)        printf 'bill' ;;
    central)        printf 'ctr' ;;
    connectivity)   printf 'conn' ;;
    configuration)  printf 'cfg' ;;
    container)      printf 'ctr' ;;
    database)       printf 'db' ;;
    developer)      printf 'dev' ;;
    development)    printf 'dev' ;;
    devops)         printf 'devops' ;;
    disaster)       printf 'dis' ;;
    encryption)     printf 'enc' ;;
    engineer)       printf 'eng' ;;
    engineering)    printf 'eng' ;;
    environment)    printf 'env' ;;
    external)       printf 'ext' ;;
    factory)        printf 'fctry' ;;
    general)        printf 'gen' ;;
    gitlab)         printf 'gitlab' ;;
    infosec)        printf 'infosec' ;;
    infra)          printf 'infra' ;;
    infrastructure) printf 'infra' ;;
    internal)       printf 'int' ;;
    internet)       printf 'inet' ;;
    image)          printf 'img' ;;
    isolated)       printf 'isol' ;;
    kubernetes)     printf 'k8s' ;;
    management)     printf 'mgmt' ;;
    middleware)     printf 'mw' ;;
    namespace)      printf 'ns' ;;
    observability)  printf 'obs' ;;
    packages)       printf 'pkgs' ;;
    playground)     printf 'pg' ;;
    production)     printf 'prod' ;;
    provisioning)   printf 'prov' ;;
    public)         printf 'pub' ;;
    recovery)       printf 'rec' ;;
    repository)     printf 'repo' ;;
    sandbox)        printf 'sbx' ;;
    service)        printf 'svc' ;;
    services)       printf 'svcs' ;;
    staging)        printf 'stg' ;;
    toolset)        printf 'toolset' ;;
    voice)          printf 'voice' ;;
    *)
      consonants="${word//[aeiou]/}"
      if [[ -z "$consonants" ]]; then
        printf '%s' "${word:0:4}"
      else
        printf '%s' "${consonants:0:4}"
      fi
      ;;
  esac
}

acronym() {
  if [[ $# -lt 1 || $# -gt 2 ]]; then
    printf 'Usage: %s INPUT [SEPARATOR]\n' "${0##*/}" >&2
    return 2
  fi

  local input="$1"
  local separator="${2:--}"
  local word
  local -a words result=()

  input="${input//_/-}"
  input="${input// /-}"
  IFS='-' read -r -a words <<< "$input"

  for word in "${words[@]}"; do
    [[ -n "$word" ]] && result+=("$(acronym_word "$word")")
  done

  local IFS="$separator"
  printf '%s\n' "${result[*]}"
}

acronym "$@"
